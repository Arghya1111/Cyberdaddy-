# ===========================================================
# CyberDaddy Frontend — Environment Variables
# Copy this file to .env.local for local development.
# All NEXT_PUBLIC_* vars are baked into the client bundle at
# build time. Never put secrets in NEXT_PUBLIC_ variables.
# ===========================================================

# ── Backend API URL (optional) ──────────────────────────────
# In production (Vercel), leave this UNSET so Next.js rewrites
# in next.config.ts proxy /api/* to the Django backend without
# exposing the backend origin to clients.
#
# Set this ONLY for local development when you want to hit the
# Django dev server directly (bypasses the Next.js proxy):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# The production Render backend URL is:
#   NEXT_PUBLIC_API_URL=https://cyberdaddy.onrender.com
NEXT_PUBLIC_API_URL=

# ── Groq AI (required) ──────────────────────────────────────
# Used client-side for real-time chat & screenshot analysis.
# Get your key at: https://console.groq.com/keys
# WARNING: this key is visible in the browser bundle.
#          Rotate it regularly and restrict its usage in Groq.
NEXT_PUBLIC_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App metadata (optional, has defaults) ───────────────────
NEXT_PUBLIC_APP_NAME=CyberDaddy
