# ============================================================
# CyberDaddy - Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# --- Django Core ---
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.production

# --- Database (PostgreSQL) ---
DB_NAME=cyberdaddy
DB_USER=cyberdaddy_user
DB_PASSWORD=your-db-password
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://cyberdaddy_user:your-db-password@postgres:5432/cyberdaddy

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_URL=redis://redis:6379/3

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=cyberdaddy-media
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@cyberdaddy.in
SENDGRID_API_KEY=your-sendgrid-api-key

# --- Twilio SMS ---
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- Stripe ---
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxx
STRIPE_PRICE_FAMILY_MONTHLY=price_xxx
STRIPE_PRICE_FAMILY_YEARLY=price_xxx

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- OpenAI ---
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o

# --- Groq AI (faster & cheaper alternative to OpenAI) ---
GROQ_API_KEY=gsk_xxx

# --- Firebase (Push Notifications) ---
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-credentials.json

# --- Sentry ---
SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# --- App ---
FRONTEND_URL=https://cyberdaddy.in
INVITE_CODE_EXPIRY_HOURS=48
MAX_FAMILY_MEMBERS=10
